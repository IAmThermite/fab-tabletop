# Git
.git

# Dev/test artifacts
tabletop/_build
tabletop/deps
tabletop/assets/node_modules
tabletop/.elixir_ls

# Rebuilt by `mix assets.deploy`; dev-only self-signed certs
tabletop/priv/static/assets
tabletop/priv/static/cache_manifest.json
tabletop/priv/cert

# Editing sources kept beside the served images (~263MB). Nothing in lib/ or
# assets/ references them, but `COPY tabletop/priv priv` bakes everything under
# priv into the release, so without this they ship to Fly on every deploy.
tabletop/priv/static/images/**/*_orig.*

# Vendored card data: the build only needs the precomputed card.json
# (see infrastructure/Dockerfile). The rest of the submodule — csvs/, web/,
# other languages — is ~60MB of dead weight in the build context.
vendor
!vendor/flesh-and-blood-cards/json/english/card.json

# Docker
docker-compose.yml

# Misc
.env
.github
.claude
.vscode
*.md
*.dump
